# Copia este fichero como .env y rellena tus datos. NUNCA subas .env a GitHub.

# Modelo local (Ollama)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2:3b

# Modelo de pago (cualquier proveedor compatible con la API de OpenAI)
PAGO_BASE_URL=https://api.mistral.ai/v1
PAGO_MODEL=mistral-small-latest
PAGO_API_KEY=pon-aqui-tu-clave

# Precios del modelo de pago en euros por millón de tokens (consulta los actuales)
PAGO_PRECIO_ENTRADA=0.0
PAGO_PRECIO_SALIDA=0.0

UMBRAL_TOKENS_COMPLEJO=1500
RUTA_BD=registro.db
